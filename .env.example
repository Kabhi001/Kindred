# Kindred Hostel Roommate Matcher - Example Environment Template
# Copy this file to .env and adjust values for your environment.

# Security & Environment
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=hostel.yourcollege.edu,127.0.0.1,localhost

# Database (PostgreSQL recommended for production concurrency)
DATABASE_URL=postgres://user:password@localhost:5432/kindred
# Alternatively, discrete variables:
# DJANGO_DB_ENGINE=postgresql
# POSTGRES_DB=kindred
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Transactional Email Gateway for OTPs & Allotment Notifications
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=Kindred Allotments <allotments@yourcollege.edu>

# HTTPS / Cookie Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
